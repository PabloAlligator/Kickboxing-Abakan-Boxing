{
  "name": "sodruzhestvo-control",
  "version": "3.0.0",
  "private": true,
  "description": "Публичный сайт и закрытая система управления спортивным клубом Содружество",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "css": "sass site/styles/main.scss site/css/main.css --style=expanded --source-map && sass site/styles/admin/admin.scss site/css/admin.css --style=expanded --source-map",
    "css:min": "sass site/styles/main.scss site/css/main.min.css --style=compressed --no-source-map && sass site/styles/admin/admin.scss site/css/admin.min.css --style=compressed --no-source-map",
    "css:watch": "sass --watch site/styles/main.scss:site/css/main.css site/styles/admin/admin.scss:site/css/admin.css --style=expanded --source-map",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "node scripts/ensure-sqlite.js && prisma migrate deploy",
    "owner:create": "node scripts/create-owner.js",
    "test": "node scripts/run-tests.js",
    "test:security": "node scripts/run-tests.js tests/security.test.js",
    "audit:prod": "npm audit --omit=dev",
    "db:info": "node scripts/db-info.js",
    "prisma:seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "argon2": "0.45.1",
    "compression": "1.8.1",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "express-rate-limit": "8.7.0",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "web-push": "3.6.7",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "sass": "1.93.2",
    "supertest": "7.1.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "effect": "3.20.0"
  }
}
